{
  "name": "opencode-smart-fallback",
  "version": "2.0.0",
  "description": "Production-grade OpenCode V2 plugin for multi-hop free-tier model waterfalls, per-agent chains, tiered cooldowns, and zero-cancellation subagent failover.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai",
    "plugin",
    "model-fallback",
    "fallback-chain",
    "rate-limit",
    "failover",
    "model-routing",
    "waterfall",
    "llm"
  ],
  "author": "Oren Schmerling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oren-Schmerling/opencode-smart-fallback.git"
  },
  "homepage": "https://github.com/Oren-Schmerling/opencode-smart-fallback#readme",
  "bugs": {
    "url": "https://github.com/Oren-Schmerling/opencode-smart-fallback/issues"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
